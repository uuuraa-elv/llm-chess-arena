# Salin file ini menjadi .env lalu isi key OpenRouter Anda.
# Dapatkan key di https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opsional: base URL provider LLM (default OpenRouter). Isi untuk pakai endpoint
# OpenAI-compatible lain. Bisa juga diatur lewat menu Pengaturan (gigi) di aplikasi.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Opsional: identitas app yang dikirim ke OpenRouter (muncul di dashboard mereka).
OPENROUTER_APP_TITLE=LLM Chess Arena
OPENROUTER_APP_URL=https://github.com/local/llm-chess-arena
